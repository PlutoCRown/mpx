{
  "transform": {
    "^.+\\.tsx?$": ["babel-jest", { "rootMode": "upward" }]
  },
  "testEnvironment": "node",
  "testMatch": ["**/__tests__/**/*.test.ts"],
  "testPathIgnorePatterns": ["/dist/", "/examples/web/dist/", "/examples/rn/dist/", "/examples/rn/dist-webpack/"],
  "moduleNameMapper": {
    "^@mpxjs/compiler$": "<rootDir>/../compiler/src/index.ts"
  },
  "testTimeout": 120000
}
