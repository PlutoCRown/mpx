<template mode="wx">
  <view>wx-only-template</view>
</template>

<template>
  <view class="page">
    <text class="title">{{ title }}</text>
    <view wx:if="{{ show }}">visible</view>
    <view wx:else>hidden</view>
    <view wx:for="{{ items }}" wx:key="id" wx:for-item="item">
      <text>{{ item.name }}</text>
    </view>
    <view bindtap="onTap" class="action">tap {{ count }}</view>
    <view catchtap="onCatch">stop</view>
    <child></child>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'

createPage({
  data: {
    title: 'MPX Web',
    show: true,
    count: 1,
    items: [{ id: 'a', name: 'Alpha' }]
  },
  methods: {
    onTap () {
      this.count += 1
    },
    onCatch () {}
  }
})
</script>

<style>
.page {
  color: #222;
}
</style>

<style mode="web">
.web-only {
  display: block;
}
</style>

<style mode="wx">
.wx-only {
  display: none;
}
</style>

<script type="application/json">
{
  "usingComponents": {
    "child": "./child"
  },
  "navigationBarTitleText": "Hello"
}
</script>
